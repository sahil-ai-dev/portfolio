# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your secure secrets.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Flask Core Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# Generate a secure 32-byte key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-here

# Database Configuration (defaults to SQLite in instance/portfolio.db)
# If left unset, the app uses instance/portfolio.db automatically.
DATABASE_URL=sqlite:///instance/portfolio.db

# Initial Admin Credentials (used by init_db.py)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_EMAIL=your_email@example.com

# File Upload Limits (in bytes, 5MB = 5242880)
MAX_CONTENT_LENGTH=5242880

# Optional Public GitHub Integration
GITHUB_USERNAME=

# Optional AI Chatbot API (Leave blank to use the built-in verified FAQ chatbot)
AI_API_KEY=
AI_PROVIDER=none
AI_MODEL=gemini-1.5-flash
